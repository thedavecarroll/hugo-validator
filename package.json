{
  "name": "hugo-validator",
  "version": "2.0.1",
  "description": "Comprehensive validation pipeline for Hugo sites - pre-commit hooks, accessibility testing, link checking, and more",
  "keywords": [
    "hugo",
    "validator",
    "validation",
    "accessibility",
    "wcag",
    "playwright",
    "pre-commit",
    "html-validate",
    "stylelint"
  ],
  "author": "Dave Carroll",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedavecarroll/hugo-validator.git"
  },
  "bugs": {
    "url": "https://github.com/thedavecarroll/hugo-validator/issues"
  },
  "homepage": "https://github.com/thedavecarroll/hugo-validator#readme",
  "bin": {
    "hugo-validator": "./bin/hugo-validator.js"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./configs/stylelint": "./configs/stylelint.base.json",
    "./configs/htmlvalidate": "./configs/htmlvalidate.base.js"
  },
  "files": [
    "bin",
    "lib",
    "tests",
    "configs"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test \"test/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.e2e.js\"",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "commander": "^15.0.0",
    "html-validate": "^11.16.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "hugoValidator": {
    "minHugoVersion": "0.128.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "devDependencies": {
    "@types/node": "^24.13.6",
    "sass-embedded": "^1.104.1",
    "semver": "^7.8.5",
    "typescript": "^7.0.2"
  }
}
